# Configuration optionnelle pour les intégrations bancaires/paiements luxembourgeoises
# Copier ce fichier en .env (non commité) et remplir avec vos clés.

# === Banques luxembourgeoises (PSD2 / Open Banking) ===
# La plupart des banques LU (BCEE, BIL, BGL BNP Paribas, Banque Raiffeisen, ING Luxembourg)
# exposent leurs comptes via l'API PSD2 standard (Berlin Group NextGenPSD2).
# Passez généralement par un agrégateur agréé (Tink, Salt Edge, Klarna Kosma, Bridge by Bud).

# Exemple Tink :
# TINK_CLIENT_ID=
# TINK_CLIENT_SECRET=

# === Peppol B2G (e-invoicing obligatoire vers le secteur public LU) ===
# Point d'accès Peppol agréé (ex. Storecove, Pagero, Unifiedpost).
# PEPPOL_AP_ENDPOINT=
# PEPPOL_AP_API_KEY=
# Identifiant Peppol de votre société (format 0208:LU<matricule>)
# PEPPOL_PARTICIPANT_ID=

# === Stripe (paiements en ligne, multi-pays) ===
# Dashboard > Developers > API keys
STRIPE_SECRET=sk_live_...

# Si plusieurs comptes Stripe séparés :
# STRIPE_SECRET_SHOP=sk_live_...

# Si Stripe Connect (clé plateforme + sous-comptes acct_xxx dans company.json) :
# STRIPE_PLATFORM_SECRET=sk_live_...

# === eCDF (dépôt déclarations fiscales LU) ===
# Identifiants LuxTrust (smartcard / token / Mobile)
# Note : pas d'API publique, dépôt manuel via portail ecdf.b2g.etat.lu
# Variables réservées pour futurs scripts de génération de fichiers .ecdf
# ECDF_MATRICULE=
# ECDF_BUREAU_IMPOSITION=

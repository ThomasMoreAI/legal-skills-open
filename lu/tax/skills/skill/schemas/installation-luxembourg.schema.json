{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "installation-luxembourg.schema.json",
  "title": "installation-luxembourg — parcours chronologique d'installation",
  "type": "object",
  "required": ["as_of", "etapes"],
  "properties": {
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string" },
    "url_source": { "type": "string", "pattern": "^https?://" },
    "etapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "phase", "titre", "public", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "phase": { "type": "string", "enum": ["avant_arrivee", "premiere_semaine", "premier_mois", "trois_mois", "annuel"] },
          "titre": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "public": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["tous", "ue", "hors_ue"] } },
          "condition": {
            "type": "object",
            "required": ["champ", "operateur"],
            "properties": {
              "champ": { "type": "string" },
              "operateur": { "type": "string", "enum": ["egal", "different", "vrai", "faux", "present", "absent", "superieur", "inferieur", "contient"] }
            }
          },
          "administration": { "type": "string" },
          "delai": { "type": "string" },
          "obligationId": { "type": "string" },
          "source": { "type": "string", "pattern": "^https?://" }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evenements-vie.schema.json",
  "title": "evenements-vie — ontologie des événements de vie",
  "type": "object",
  "required": ["as_of", "evenements"],
  "properties": {
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string" },
    "url_source": { "type": "string", "pattern": "^https?://" },
    "evenements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nom", "motsCles", "consequences", "administrations", "obligations", "documents", "delais", "checklist", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "nom": { "type": "string", "minLength": 1 },
          "motsCles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "consequences": { "type": "array", "items": { "type": "string" } },
          "administrations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nom"],
              "properties": { "id": { "type": "string" }, "nom": { "type": "string" } }
            }
          },
          "obligations": { "type": "array", "items": { "type": "string" } },
          "obligationsHorsCatalogue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["nom", "source"],
              "properties": { "id": { "type": "string" }, "nom": { "type": "string" }, "source": { "type": "string", "pattern": "^https?://" } }
            }
          },
          "documents": { "type": "array", "items": { "type": "string" } },
          "delais": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["quoi", "delai"],
              "properties": { "quoi": { "type": "string" }, "delai": { "type": "string" } }
            }
          },
          "exceptions": { "type": "array", "items": { "type": "string" } },
          "checklist": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string", "pattern": "^https?://" }
        }
      }
    }
  }
}

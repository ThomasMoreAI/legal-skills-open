{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "obligations.schema.json",
  "title": "obligations — catalogue d'obligations administratives sourcées",
  "type": "object",
  "required": ["as_of", "obligations"],
  "properties": {
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string" },
    "url_source": { "type": "string", "pattern": "^https?://" },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nom", "categorie", "frequence", "provenance", "statut"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "nom": { "type": "string", "minLength": 1 },
          "categorie": { "type": "string", "minLength": 1 },
          "populationConcernee": { "type": "array", "items": { "type": "string" } },
          "conditionsApplicabilite": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["champ", "operateur"],
              "properties": {
                "champ": { "type": "string", "minLength": 1 },
                "operateur": {
                  "type": "string",
                  "enum": ["egal", "different", "vrai", "faux", "present", "absent", "superieur", "inferieur", "contient"]
                }
              }
            }
          },
          "frequence": {
            "type": "string",
            "enum": ["mensuelle", "trimestrielle", "annuelle", "ponctuelle"]
          },
          "dateLimite": { "type": ["string", "null"] },
          "autoriteCompetente": { "type": ["string", "null"] },
          "piecesRequises": { "type": "array", "items": { "type": "string" } },
          "penalites": { "type": ["string", "null"] },
          "provenance": {
            "type": "object",
            "required": ["source", "dateVerification", "niveauConfiance"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "dateVerification": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "niveauConfiance": {
                "type": "string",
                "enum": ["officiel", "derive", "estimation", "incertain"]
              },
              "note": { "type": "string" }
            }
          },
          "statut": { "type": "string", "enum": ["actif", "obsolete"] },
          "validite": {
            "type": "object",
            "required": ["validFrom", "juridiction", "version"],
            "properties": {
              "validFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "validUntil": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "juridiction": { "type": "string" },
              "langue": { "type": "string" },
              "version": { "type": "string" },
              "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          },
          "gouvernance": {
            "type": "object",
            "required": ["owner", "status", "reviewFrequency", "lastVerified", "nextReview"],
            "properties": {
              "owner": { "type": "string" },
              "status": { "type": "string", "enum": ["draft", "verified", "a_revoir", "deprecated"] },
              "reviewFrequency": { "type": "string" },
              "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "nextReview": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "changeLog": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["date", "reason"],
                  "properties": {
                    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                    "reason": { "type": "string" },
                    "author": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "administrative-case.schema.json",
  "title": "Dossier (AdministrativeCase) — moteur de diagnostic administratif",
  "type": "object",
  "required": ["type", "categorie", "statut", "priorite", "dateCreation"],
  "properties": {
    "type": { "const": "Dossier" },
    "id": { "type": ["string", "null"] },
    "categorie": { "type": "string", "minLength": 1 },
    "administration": { "type": ["string", "null"] },
    "typeDemarche": { "type": ["string", "null"] },
    "statut": { "type": "string", "enum": ["a_preparer", "en_attente_information", "pret_a_envoyer", "envoye", "en_attente_reponse", "termine", "en_retard", "bloque"] },
    "priorite": { "type": "string", "enum": ["obligatoire_maintenant", "a_faire_prochainement", "a_surveiller", "non_applicable", "informations_manquantes"] },
    "dateCreation": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "echeance": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "periode": { "type": ["string", "null"] },
    "documentsRequis": { "type": "array" },
    "documentsRecus": { "type": "array" },
    "informationsManquantes": { "type": "array" },
    "risques": { "type": "array" },
    "prochainesActions": { "type": "array" },
    "profilId": { "type": ["string", "null"] },
    "societeId": { "type": ["string", "null"] },
    "obligationId": { "type": ["string", "null"] },
    "documentId": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "required": ["source", "dateVerification", "niveauConfiance"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "dateVerification": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "niveauConfiance": { "type": "string", "enum": ["officiel", "derive", "estimation", "incertain"] },
        "validationHumaineRequise": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "_base.schema.json",
  "title": "base — schéma minimal commun à tous les data/*.json",
  "type": "object",
  "required": ["as_of"],
  "properties": {
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": { "type": "string" },
    "pays": { "type": "string" },
    "url": { "type": "string", "pattern": "^https?://" },
    "url_source": { "type": "string", "pattern": "^https?://" }
  }
}

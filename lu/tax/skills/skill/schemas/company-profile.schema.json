{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "company-profile.schema.json",
  "title": "ProfilSociete (CompanyProfile) — moteur de diagnostic administratif",
  "type": "object",
  "required": ["type", "nom", "statut", "dateMiseAJour"],
  "properties": {
    "type": { "const": "ProfilSociete" },
    "id": { "type": ["string", "null"] },
    "nom": { "type": "string", "minLength": 1 },
    "formeJuridique": { "type": ["string", "null"] },
    "rcs": { "type": ["string", "null"] },
    "tva": { "type": ["string", "null"] },
    "autorisationEtablissement": { "type": ["string", "null"] },
    "beneficiairesEffectifs": { "type": "array" },
    "adresse": { "type": ["string", "null"] },
    "secteur": { "type": ["string", "null"] },
    "regimeTVA": { "type": ["string", "null"], "enum": ["normal", "franchise", "forfaitaire", "non_assujetti", "exonere", null] },
    "frequenceTVA": { "type": ["string", "null"], "enum": ["mensuelle", "trimestrielle", "annuelle", "non_applicable", null] },
    "nbSalaries": { "type": "integer", "minimum": 0 },
    "exerciceComptable": { "type": ["string", "null"] },
    "dateCreation": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "statut": { "type": "string", "enum": ["actif", "cessation", "liquidation"] },
    "obligationsConnues": { "type": "array" },
    "dateMiseAJour": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}

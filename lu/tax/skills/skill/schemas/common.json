{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.json",
  "definitions": {
    "metaSource": {
      "type": "object",
      "required": ["source", "url", "as_of"],
      "properties": {
        "source": { "type": "string", "minLength": 5 },
        "url": { "type": "string", "pattern": "^https?://" },
        "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "tauxPourcent": { "type": "number", "minimum": 0, "maximum": 100 },
    "montantEur": { "type": "number", "minimum": 0 }
  }
}

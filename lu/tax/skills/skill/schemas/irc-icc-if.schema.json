{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "irc-icc-if",
  "type": "object",
  "required": ["as_of"],
  "properties": {
    "pays": { "const": "Luxembourg" },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "irc_impot_revenu_collectivites": {
      "type": "object",
      "properties": {
        "tranches_2025": { "type": "array", "minItems": 1 },
        "tranches_2026": { "type": "array", "minItems": 1 }
      }
    },
    "icc_impot_commercial_communal": { "type": "object" },
    "if_impot_fortune": { "type": "object" }
  }
}

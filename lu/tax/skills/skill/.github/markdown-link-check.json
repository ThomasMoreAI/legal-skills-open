{
  "ignorePatterns": [
    { "pattern": "^http://localhost" },
    { "pattern": "^https://github.com/<votre-user>" }
  ],
  "replacementPatterns": [],
  "httpHeaders": [
    {
      "urls": ["https://data.legilux.public.lu", "https://legilux.public.lu"],
      "headers": { "User-Agent": "Mozilla/5.0 PaperasseLuxLinkCheck" }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 2,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 301, 302, 308, 403, 999]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucianum7/AuditorProcessual/schemas/page.schema.json",
  "title": "Page-level extraction record",
  "type": "object",
  "required": ["pdf_page", "text", "source", "quality", "summary", "entities", "keywords", "content_blocks", "visuals", "render", "vision", "ocr", "consolidation", "status"],
  "properties": {
    "pdf_page": {"type": "integer", "minimum": 1},
    "text": {"type": "string"},
    "source": {"type": "string"},
    "quality": {"type": "string"},
    "court_page": {"type": ["integer", "null"]},
    "piece": {"type": "string"},
    "document_id": {"type": "string"},
    "dates": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "entities": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "content_blocks": {"type": "array", "items": {"type": "object"}},
    "visuals": {"type": "array", "items": {"$ref": "visual_element.schema.json"}},
    "render": {"type": "object"},
    "vision": {"type": "object"},
    "ocr": {"type": "object"},
    "consolidation": {"type": "object"},
    "status": {"enum": ["COMPLETE", "COMPLETE_WITH_LIMITATION", "PARTIAL", "FAILED"]}
  },
  "additionalProperties": true
}

# Turso database configuration
# Copy this file to .env (in project root) and fill in your values
# Get these from https://turso.tech — your database dashboard

# Production Turso DB URL (libsql protocol)
DATABASE_URL=libsql://your-db-name-your-org.turso.io

# Turso auth token (long-lived, regenerate anytime)
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.your-token-here

# Optional: Z.AI API key for LLM features (used by Next.js app, not ingest scripts)
# Z_AI_API_KEY=
